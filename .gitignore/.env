# ---------- Server IP ----------
HOST_IP=192.168.115.128

# ---------- Compose ----------
AIRFLOW_IMAGE_NAME=airflow-custom:3.1.0
AIRFLOW_UID=1000

# ---------- Postgres ----------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BROWSER_REDIRECT_URL=http://192.168.115.128:9003

# ---------- Airflow core ----------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
AIRFLOW__API_AUTH__JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
AIRFLOW__API__SECRET_KEY=local-dev-api-secret-change-me-0123456789

# Konteynerlər arası (daxili) ünvan, IP ilə əvəz etməyin
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-api-server:8080/execution/

# Xaricdən (brauzerdən) giriş ünvanı
AIRFLOW__API__BASE_URL=http://192.168.115.128:8081

# ---------- Airflow 3 login (local dev) ----------
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_ALL_ADMINS=true

# ---------- MinIO endpoint (DAG-larda, konteynerlər arası) ----------
MINIO_ENDPOINT=http://minio:9000